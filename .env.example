# Copy to .env and fill in real values. Never commit the real .env file.

# --- AWS (storage layer) ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=retail-sales-raw-data
AWS_S3_RAW_PREFIX=raw/sales/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Snowflake / Snowpark (transformation layer) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RETAIL_SALES_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_RAW_TABLE=SALES_RAW
SNOWFLAKE_CURATED_TABLE=SALES_CURATED
SNOWFLAKE_STAGE=SALES_S3_STAGE

# --- Pipeline ---
LOCAL_SALES_CSV=data/sales.csv
CHARTS_OUTPUT_DIR=outputs/charts
# "local" runs entirely on pandas (no cloud needed, good for dev/demo).
# "snowflake" runs the real S3 -> Snowpark pipeline (requires the vars above).
PIPELINE_ENGINE=local
